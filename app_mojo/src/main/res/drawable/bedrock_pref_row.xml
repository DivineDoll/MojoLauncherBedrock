<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="@color/bedrock_border"/></shape></item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle"><solid android:color="@color/bedrock_stone_pressed"/></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="@color/bedrock_border"/></shape></item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle"><solid android:color="@color/bedrock_stone"/></shape>
            </item>
            <item android:left="2dp" android:top="4dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle"><solid android:color="@color/bedrock_stone_dark"/></shape>
            </item>
        </layer-list>
    </item>
</selector>
